{
  "name": "varbase_media_demo",
  "description": "Provide a pre-set of default media assets for all Varbase Media Types, which are needed in development, testing, and demos.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Media",
    "Demo"
  ],
  "author": "Vardot",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "eslint --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-plugin-yml": "^1.18.0"
  },
  "packageManager": "yarn@4.9.3"
}
